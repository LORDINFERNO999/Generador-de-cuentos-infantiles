# ============================================================
# Variables de entorno. Copia este archivo como .env (o .env.local en dev)
# y rellena los valores. NUNCA subas el .env real al repositorio.
# ============================================================

# --- Obligatorio: IA de Gemini ---
# Clave de la API de Google Gemini (genera cuento, imágenes, voces y metadata).
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# --- Servidor ---
# Puerto del servidor. En Hostinger normalmente lo asigna el panel; déjalo
# vacío o usa el que te indiquen. En local, 3000 está bien.
PORT=3000

# URL pública donde se aloja la app. Se usa para los callbacks de OAuth.
# Ej: https://cuentos.tudominio.com
APP_URL="https://tu-dominio.com"

# --- Opcional: Publicación directa en YouTube (OAuth de Google) ---
# Crea las credenciales en Google Cloud Console (YouTube Data API v3).
# Redirect URI autorizado: {APP_URL}/api/social/callback/youtube
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Opcional: Facebook / Instagram (OAuth de Meta) ---
# Requiere app de Meta, cuenta Business y App Review.
# Redirect URI: {APP_URL}/api/social/callback/facebook (y /instagram)
META_APP_ID=""
META_APP_SECRET=""
